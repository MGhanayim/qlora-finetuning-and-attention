# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# Nebius Token Factory API key (https://tokenfactory.nebius.com/)
# Used by the teacher LLM in Task 1.1 (dataset generation).
NEBIUS_API_KEY=your-key-here

# Nebius API base URL (OpenAI-compatible). Usually no need to change.
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

# HuggingFace Hub token (https://huggingface.co/settings/tokens)
# Used in Task 1.2 to push trained adapters. Not required for Task 1.1.
# HF_TOKEN=your-hf-token-here
